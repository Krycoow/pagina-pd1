---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
---

<Layout title="Iniciar Sesión | NeonClouds">
  <div class="auth-page animate-fade-in-up">
    <div class="container auth-container">
      <div class="auth-card glow-effect levitate" style="animation-duration: 8s;">
        <div class="auth-header">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="auth-icon"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path><polyline points="10 17 15 12 10 7"></polyline><line x1="15" y1="12" x2="3" y2="12"></line></svg>
          <h1 class="auth-title">INICIAR SESIÓN</h1>
          <p class="auth-subtitle">Accede a tu cuenta para comprar nubes épicas.</p>
        </div>
        
        <form id="loginForm" class="auth-form">
          <div class="form-group">
            <label for="email">Correo Electrónico</label>
            <input type="email" id="email" name="email" required placeholder="tucorreo@ejemplo.com" class="auth-input" />
          </div>
          
          <div class="form-group">
            <label for="password">Contraseña</label>
            <input type="password" id="password" name="password" required placeholder="••••••••" class="auth-input" />
          </div>
          
          <Button type="submit" variant="primary" class="w-full auth-submit">ENTRAR AHORA</Button>
        </form>
        
        <div class="auth-footer">
          <p>¿No tienes cuenta? <a href="/register" class="text-primary hover-underline">Regístrate aquí</a></p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { loginUser } from '../store/auth';

  document.addEventListener('DOMContentLoaded', () => {
    const loginForm = document.getElementById('loginForm');
    
    loginForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const emailInput = document.getElementById('email') as HTMLInputElement;
      
      if (emailInput && emailInput.value) {
        // Simulamos un login exitoso usando el email como nombre
        const namePart = emailInput.value.split('@')[0];
        const formattedName = namePart.charAt(0).toUpperCase() + namePart.slice(1);
        
        loginUser({
          name: formattedName,
          email: emailInput.value
        });
        
        // Redirigir al inicio tras loguearse
        window.location.href = '/';
      }
    });
  });
</script>

<style>
  .auth-page {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 0;
    position: relative;
    overflow: hidden;
  }
  
  /* Radiación de fondo */
  .auth-page::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(0, 255, 102, 0.1) 0%, transparent 60%);
    z-index: -1;
  }

  .auth-container {
    max-width: 500px;
    width: 100%;
  }

  .auth-card {
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 3rem 2.5rem;
    box-shadow: var(--shadow-elevated);
    position: relative;
  }
  
  .auth-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  
  .auth-icon {
    margin-bottom: 1rem;
    filter: drop-shadow(0 0 10px var(--color-primary-glow));
  }

  .auth-title {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    letter-spacing: 0.05em;
  }

  .auth-subtitle {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .auth-input {
    background-color: var(--color-bg);
    border: 1px solid var(--border-color);
    color: var(--color-text);
    padding: 1rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    outline: none;
    transition: all var(--transition-fast);
  }

  .auth-input:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 1px var(--color-primary), inset 0 0 10px rgba(0, 255, 102, 0.1);
  }

  .auth-submit {
    margin-top: 1rem;
    padding: 1.2rem;
    font-size: 1.1rem;
    letter-spacing: 0.1em;
  }

  .w-full {
    width: 100%;
  }

  .auth-footer {
    margin-top: 2rem;
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .text-primary {
    color: var(--color-primary);
    font-weight: 600;
  }

  .hover-underline:hover {
    text-decoration: underline;
  }
</style>
