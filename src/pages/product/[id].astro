---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/ui/Button.astro';

// getStaticPaths es necesario en Astro para generar rutas dinámicas en un sitio estático
export function getStaticPaths() {
  const allProducts = [
    {
      id: 'p1',
      name: 'Chaqueta Táctica Asatro X-1',
      price: 189.99,
      category: 'Ropa',
      description: 'Chaqueta transpirable de nivel 4 impermeable con recubrimiento de teflón. Diseñada para entornos hostiles donde cada detalle cuenta. Multitud de bolsillos ocultos y refuerzos de Cordura en zonas de choque.',
      features: ['100% Impermeable', 'Refuerzos en codos', '8 bolsillos tácticos', 'Capucha plegable'],
      image: 'https://images.unsplash.com/photo-1591047139829-d91aecb6caea?q=80&w=1000&auto=format&fit=crop'
    },
    {
      id: 'p2',
      name: 'Botas de Combate Urbanas',
      price: 145.50,
      category: 'Calzado',
      description: 'Botas ligeras de intervención diseñadas para asfalto. Suela antideslizante con absorción de impactos y sistema de atado rápido.',
      features: ['Suela Vibram', 'Punta reforzada', 'Cremallera lateral', 'Transpirables'],
      image: 'https://images.unsplash.com/photo-1608256246200-53e635b5b65f?q=80&w=1000&auto=format&fit=crop'
    },
    {
      id: 'p3',
      name: 'Mochila Stealth 45L',
      price: 120.00,
      category: 'Accesorios',
      description: 'Capacidad expansible y sistema MOLLE cortado por láser para un perfil bajo. Ideal para misiones de 48 horas o como EDC todoterreno.',
      features: ['Nylon 1000D', 'Espalda ergonómica ventilada', 'Compartimento para portátil', 'Cremalleras YKK'],
      image: 'https://images.unsplash.com/photo-1553062407-98eeb64c6a62?q=80&w=1000&auto=format&fit=crop'
    },
    {
      id: 'p4',
      name: 'Reloj Supervivencia Pro',
      price: 210.99,
      category: 'Gear',
      description: 'El reloj definitivo para condiciones extremas. Brújula, altímetro, barómetro y batería solar en una caja de titanio reforzado.',
      features: ['Cristal de zafiro', 'Sumergible 200m', 'Carga solar', 'GPS Integrado'],
      image: 'https://images.unsplash.com/photo-1524805444758-089113d48a6d?q=80&w=1000&auto=format&fit=crop'
    },
    {
      id: 'p5',
      name: 'Pantalón Cargo Reforzado',
      price: 89.90,
      category: 'Ropa',
      description: 'Pantalón antidesgarros con tratamiento repelente al agua. Corte ergonómico que permite total libertad de movimientos.',
      features: ['Tejido Ripstop', 'Cintura elástica', 'Rodillas preformadas'],
      image: 'https://images.unsplash.com/photo-1624378439575-d8705ad7ae80?q=80&w=1000&auto=format&fit=crop'
    },
    {
      id: 'p6',
      name: 'Linterna LED 5000 Lumens',
      price: 45.00,
      category: 'Gear',
      description: 'Iluminación táctica cegadora de 5000 lumens con cuerpo de aluminio aeroespacial. Múltiples modos incluyendo estroboscópico defensivo.',
      features: ['Aluminio T6061', 'Batería recargable USB-C', 'Modo SOS', 'Resistente a caídas 2m'],
      image: 'https://images.unsplash.com/photo-1520696924847-acdbbc922849?q=80&w=1000&auto=format&fit=crop'
    },
    {
      id: 'p7',
      name: 'Guantes Kevlar Blackout',
      price: 35.50,
      category: 'Accesorios',
      description: 'Protección máxima sin perder destreza. Nudillos reforzados y material anti-corte en la palma.',
      features: ['Protección Kevlar', 'Compatibles con pantallas táctiles', 'Ajuste de velcro TPR'],
      image: 'https://images.unsplash.com/photo-1549880181-56a44cf4a9a5?q=80&w=1000&auto=format&fit=crop'
    },
    {
      id: 'p8',
      name: 'Cuchillo Táctico Karambit',
      price: 75.99,
      category: 'Gear',
      description: 'Hoja fija de acero D2 con recubrimiento de titanio negro. Funda Kydex de extracción rápida. Diseño brutal y efectivo.',
      features: ['Acero D2', 'Mango G10', 'Anillo de retención', 'Funda multiposición'],
      image: 'https://images.unsplash.com/photo-1604085572504-a392ddf0d86a?q=80&w=1000&auto=format&fit=crop'
    }
  ];

  return allProducts.map(product => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
---

<Layout title={`${product.name} | Asatro`}>
  <div class="product-page">
    <div class="container py-xl">
      <div class="breadcrumb">
        <a href="/">Inicio</a> <span class="separator">/</span>
        <a href="/products">Catálogo</a> <span class="separator">/</span>
        <span class="current">{product.category}</span>
      </div>

      <div class="product-layout">
        <!-- Imágenes del Producto -->
        <div class="product-gallery">
          <div class="main-image-wrapper glow-effect">
            <img src={product.image} alt={product.name} class="main-image" />
          </div>
          <div class="thumbnails">
            <button class="thumbnail active"><img src={product.image} alt="Thumb 1" /></button>
            <button class="thumbnail"><img src={product.image} alt="Thumb 2" class="grayscale" /></button>
            <button class="thumbnail"><img src={product.image} alt="Thumb 3" class="grayscale" /></button>
          </div>
        </div>

        <!-- Información del Producto -->
        <div class="product-details">
          <div class="category-tag">{product.category}</div>
          <h1 class="product-title">{product.name}</h1>
          <p class="product-price">${product.price.toFixed(2)}</p>
          
          <div class="product-description">
            <p>{product.description}</p>
          </div>

          <div class="product-features">
            <h3>Características clave</h3>
            <ul>
              {product.features?.map((feature: string) => (
                <li>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-icon">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </div>

          <div class="product-actions">
            <div class="quantity-selector">
              <button class="qty-btn" aria-label="Disminuir" id="decreaseQty">-</button>
              <input type="number" id="purchaseQty" class="qty-input" value="1" min="1" max="99" />
              <button class="qty-btn" aria-label="Aumentar" id="increaseQty">+</button>
            </div>
            
            <Button 
              class="add-to-cart-big" 
              data-action="add"
              data-id={product.id}
              data-name={product.name}
              data-price={product.price}
              data-image={product.image}
              data-source="detail"
            >
              AÑADIR AL CARRITO
            </Button>
          </div>
          
          <div class="product-meta">
            <div class="meta-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
              <span>Envío gratis en pedidos superiores a $150</span>
            </div>
            <div class="meta-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              <span>Garantía táctica de por vida</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Lógica local para el selector de cantidad en la página de detalle
  const decreaseBtn = document.getElementById('decreaseQty');
  const increaseBtn = document.getElementById('increaseQty');
  const qtyInput = document.getElementById('purchaseQty') as HTMLInputElement;

  if (decreaseBtn && increaseBtn && qtyInput) {
    decreaseBtn.addEventListener('click', () => {
      const currentValue = parseInt(qtyInput.value);
      if (currentValue > 1) qtyInput.value = (currentValue - 1).toString();
    });

    increaseBtn.addEventListener('click', () => {
      const currentValue = parseInt(qtyInput.value);
      if (currentValue < 99) qtyInput.value = (currentValue + 1).toString();
    });
  }
</script>

<style>
  .py-xl {
    padding-top: 3rem;
    padding-bottom: 6rem;
  }

  .breadcrumb {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 3rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .breadcrumb a {
    transition: color var(--transition-fast);
  }

  .breadcrumb a:hover {
    color: var(--color-primary);
  }

  .breadcrumb .separator {
    color: var(--border-color);
  }

  .breadcrumb .current {
    color: var(--color-text);
  }

  .product-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
  }

  @media (min-width: 992px) {
    .product-layout {
      grid-template-columns: 1fr 1fr;
    }
  }

  .product-gallery {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .main-image-wrapper {
    aspect-ratio: 1/1;
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumbnails {
    display: flex;
    gap: 1rem;
  }

  .thumbnail {
    flex: 1;
    aspect-ratio: 1/1;
    border: 2px solid var(--border-color);
    border-radius: var(--radius-sm);
    overflow: hidden;
    cursor: pointer;
    transition: border-color var(--transition-fast);
  }

  .thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumbnail.active {
    border-color: var(--color-primary);
  }

  .thumbnail:hover:not(.active) {
    border-color: #52525b;
  }

  .grayscale {
    filter: grayscale(100%);
    opacity: 0.7;
    transition: all var(--transition-fast);
  }

  .thumbnail:hover .grayscale {
    filter: grayscale(0%);
    opacity: 1;
  }

  .product-details {
    display: flex;
    flex-direction: column;
  }

  .category-tag {
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }

  .product-title {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 1rem;
  }

  .product-price {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: 2rem;
  }

  .product-description {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .product-features h3 {
    font-size: 1.1rem;
    margin-bottom: 1rem;
  }

  .product-features ul {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 640px) {
    .product-features ul {
      grid-template-columns: 1fr 1fr;
    }
  }

  .product-features li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-text);
  }

  .check-icon {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .product-actions {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 640px) {
    .product-actions {
      flex-direction: row;
    }
  }

  .quantity-selector {
    display: flex;
    align-items: center;
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    overflow: hidden;
    height: 52px;
  }

  .qty-btn {
    width: 48px;
    height: 100%;
    color: var(--color-text);
    font-size: 1.2rem;
    font-weight: 500;
    transition: background-color var(--transition-fast);
  }

  .qty-btn:hover {
    background-color: #27272a;
  }

  .qty-input {
    width: 60px;
    height: 100%;
    background: transparent;
    border: none;
    color: var(--color-text);
    font-size: 1.1rem;
    font-weight: 600;
    text-align: center;
    font-family: var(--font-sans);
    -moz-appearance: textfield;
  }

  .qty-input::-webkit-outer-spin-button,
  .qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .add-to-cart-big {
    flex: 1;
    font-size: 1.1rem;
    letter-spacing: 0.05em;
    height: 52px;
  }

  .product-meta {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    background-color: var(--color-bg-secondary);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .meta-item svg {
    color: var(--color-primary);
  }
</style>
