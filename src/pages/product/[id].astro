---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/ui/Button.astro';

// getStaticPaths es necesario en Astro para generar rutas dinámicas en un sitio estático
export function getStaticPaths() {
  const allProducts = [
    {
      id: 'p1',
      name: 'Elf Bar 600 V2 - Watermelon Bubblegum',
      price: 7.50,
      category: 'Desechables',
      description: 'El clásico sabor a chicle de sandía en la versión V2 de Elf Bar. Nueva tecnología de resistencia QUAQ Mesh que garantiza un sabor más intenso desde la primera hasta la última calada.',
      features: ['600 Puffs (Caladas)', '20mg Nicotina (Sales)', 'Resistencia QUAQ Mesh', 'Batería 550mAh'],
      image: 'https://images.unsplash.com/photo-1579247289081-dc1a182b8e3c?q=80&w=1000&auto=format&fit=crop'
    },
    {
      id: 'p2',
      name: 'Vaporesso XROS 3 Pod Kit',
      price: 34.99,
      category: 'Kits & Pods',
      description: 'El mejor pod recargable del mercado. Cruza el límite del sabor y el diseño con el nuevo XROS 3. Batería de alta densidad que dura hasta 48 horas de uso con una sola carga.',
      features: ['Batería 1000mAh', 'Flujo de aire ajustable', 'Reconocimiento inteligente de resistencia', 'Carga rápida Type-C'],
      image: 'https://images.unsplash.com/photo-1546197116-bb984d4b1a53?q=80&w=1000&auto=format&fit=crop'
    },
    {
      id: 'p3',
      name: 'Riot Squad - Blue Burst 50ml',
      price: 14.50,
      category: 'Líquidos',
      description: 'Una explosión azul helada. Mezcla refrescante de frambuesa azul dulce con un final mentolado brutal. Formato Shortfill preparado para añadir el Nicokit.',
      features: ['Ratio 70VG/30PG', '50ml (Shortfill 60ml)', 'Sabor Frambuesa Azul Helada', 'Sin nicotina base (Añadir Nicokit)'],
      image: 'https://images.unsplash.com/photo-1620606180536-f3b14d245dae?q=80&w=1000&auto=format&fit=crop'
    },
    {
      id: 'p4',
      name: 'Crystal Bar 600 - Cherry Ice',
      price: 6.99,
      category: 'Desechables',
      description: 'Cerezas dulces y oscuras recogidas en su punto exacto de maduración, envueltas en una ráfaga de hielo aplastado. Diseño transparente icónico de Crystal.',
      features: ['600 Puffs (Caladas)', '20mg Nicotina (Sales)', 'Diseño transparente premium', 'Batería 500mAh'],
      image: 'https://images.unsplash.com/photo-1618252273151-a0c3260840c5?q=80&w=1000&auto=format&fit=crop'
    },
    {
      id: 'p5',
      name: 'Voopoo Drag M100S Kit',
      price: 55.90,
      category: 'Kits & Pods',
      description: 'Un equipo legendario de alta gama. Acabados en madera solida o mate antireflejos. Salida explosiva de 100W alimentada por una sola batería (no incluida).',
      features: ['Hasta 100W de potencia', 'Interruptor dinámico multifunción', 'Tanque UFORCE-L', 'A prueba de fugas'],
      image: 'https://images.unsplash.com/photo-1539185441755-769473a23570?q=80&w=1000&auto=format&fit=crop'
    },
    {
      id: 'p6',
      name: 'Just Juice - Mango & Passion Fruit 100ml',
      price: 19.95,
      category: 'Líquidos',
      description: 'Si te gustan las frutas tropicales, esto te va a volar la cabeza. Mango jugoso mezclado con fruta de la pasión para crear una combinación cítrica y dulce espectacular.',
      features: ['Ratio 70VG/30PG', 'Botella 100ml', 'Sabor Frutal Tropical', 'Fabricado en UK'],
      image: 'https://images.unsplash.com/photo-1582292850384-adfb915998a9?q=80&w=1000&auto=format&fit=crop'
    },
    {
      id: 'p7',
      name: 'Lost Mary BM600 - Triple Mango',
      price: 7.95,
      category: 'Desechables',
      description: 'El diseño cuadrado ultracompacto se une al sabor dulce e intenso a mango puro en sus notas más destacadas.',
      features: ['600 Puffs', 'Formato cuadrado bolsillo', '20mg Nicotina (Sales)', 'Activación por inhalación'],
      image: 'https://images.unsplash.com/photo-1555700770-b75b1c7dc789?q=80&w=1000&auto=format&fit=crop'
    },
    {
      id: 'p8',
      name: 'Resistencias Vaporesso GTX Mesh (Pack 5)',
      price: 12.50,
      category: 'Accesorios',
      description: 'Pack de 5 resistencias de repuesto originales de Vaporesso de malla. Excelente producción de sabor y vapor prolongado.',
      features: ['Tecnología Anti-Leak', 'Ohmiaje a elegir (0.2 a 1.2)', 'Algodón antibacteriano', 'Mayor duración'],
      image: 'https://images.unsplash.com/photo-1518066531980-60b6d2eabd70?q=80&w=1000&auto=format&fit=crop'
    }
  ];

  return allProducts.map(product => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
---

<Layout title={`${product.name} | NeonClouds`}>
  <div class="product-page">
    <div class="container py-xl">
      <div class="breadcrumb">
        <a href="/">Inicio</a> <span class="separator">/</span>
        <a href="/products">Catálogo</a> <span class="separator">/</span>
        <span class="current">{product.category}</span>
      </div>

      <div class="product-layout">
        <!-- Imágenes del Producto -->
        <div class="product-gallery">
          <div class="main-image-wrapper glow-effect">
            <img src={product.image} alt={product.name} class="main-image" />
          </div>
          <div class="thumbnails">
            <button class="thumbnail active"><img src={product.image} alt="Thumb 1" /></button>
            <button class="thumbnail"><img src={product.image} alt="Thumb 2" class="grayscale" /></button>
            <button class="thumbnail"><img src={product.image} alt="Thumb 3" class="grayscale" /></button>
          </div>
        </div>

        <!-- Información del Producto -->
        <div class="product-details">
          <div class="category-tag">{product.category}</div>
          <h1 class="product-title">{product.name}</h1>
          <p class="product-price">${product.price.toFixed(2)}</p>
          
          <div class="product-description">
            <p>{product.description}</p>
          </div>

          <div class="product-features">
            <h3>Características clave</h3>
            <ul>
              {product.features?.map((feature: string) => (
                <li>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-icon">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </div>

          <div class="product-actions">
            <div class="quantity-selector">
              <button class="qty-btn" aria-label="Disminuir" id="decreaseQty">-</button>
              <input type="number" id="purchaseQty" class="qty-input" value="1" min="1" max="99" />
              <button class="qty-btn" aria-label="Aumentar" id="increaseQty">+</button>
            </div>
            
            <Button 
              class="add-to-cart-big" 
              data-action="add"
              data-id={product.id}
              data-name={product.name}
              data-price={product.price}
              data-image={product.image}
              data-source="detail"
            >
              AÑADIR AL CARRITO
            </Button>
          </div>
          
          <div class="product-meta">
            <div class="meta-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
              <span>Envío express gratis en pedidos superiores a $50</span>
            </div>
            <div class="meta-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 14 4-4"></path><path d="M3.34 19a10 10 0 1 1 17.32 0"></path></svg>
              <span>Líquidos 100% Originales y Certificados</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Lógica local para el selector de cantidad en la página de detalle
  const decreaseBtn = document.getElementById('decreaseQty');
  const increaseBtn = document.getElementById('increaseQty');
  const qtyInput = document.getElementById('purchaseQty') as HTMLInputElement;

  if (decreaseBtn && increaseBtn && qtyInput) {
    decreaseBtn.addEventListener('click', () => {
      const currentValue = parseInt(qtyInput.value);
      if (currentValue > 1) qtyInput.value = (currentValue - 1).toString();
    });

    increaseBtn.addEventListener('click', () => {
      const currentValue = parseInt(qtyInput.value);
      if (currentValue < 99) qtyInput.value = (currentValue + 1).toString();
    });
  }
</script>

<style>
  .py-xl {
    padding-top: 3rem;
    padding-bottom: 6rem;
  }

  .breadcrumb {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 3rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .breadcrumb a {
    transition: color var(--transition-fast);
  }

  .breadcrumb a:hover {
    color: var(--color-primary);
  }

  .breadcrumb .separator {
    color: var(--border-color);
  }

  .breadcrumb .current {
    color: var(--color-text);
  }

  .product-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
  }

  @media (min-width: 992px) {
    .product-layout {
      grid-template-columns: 1fr 1fr;
    }
  }

  .product-gallery {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .main-image-wrapper {
    aspect-ratio: 1/1;
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumbnails {
    display: flex;
    gap: 1rem;
  }

  .thumbnail {
    flex: 1;
    aspect-ratio: 1/1;
    border: 2px solid var(--border-color);
    border-radius: var(--radius-sm);
    overflow: hidden;
    cursor: pointer;
    transition: border-color var(--transition-fast);
  }

  .thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumbnail.active {
    border-color: var(--color-primary);
  }

  .thumbnail:hover:not(.active) {
    border-color: #52525b;
  }

  .grayscale {
    filter: grayscale(100%);
    opacity: 0.7;
    transition: all var(--transition-fast);
  }

  .thumbnail:hover .grayscale {
    filter: grayscale(0%);
    opacity: 1;
  }

  .product-details {
    display: flex;
    flex-direction: column;
  }

  .category-tag {
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }

  .product-title {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 1rem;
  }

  .product-price {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: 2rem;
  }

  .product-description {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .product-features h3 {
    font-size: 1.1rem;
    margin-bottom: 1rem;
  }

  .product-features ul {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 640px) {
    .product-features ul {
      grid-template-columns: 1fr 1fr;
    }
  }

  .product-features li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-text);
  }

  .check-icon {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .product-actions {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 640px) {
    .product-actions {
      flex-direction: row;
    }
  }

  .quantity-selector {
    display: flex;
    align-items: center;
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    overflow: hidden;
    height: 52px;
  }

  .qty-btn {
    width: 48px;
    height: 100%;
    color: var(--color-text);
    font-size: 1.2rem;
    font-weight: 500;
    transition: background-color var(--transition-fast);
  }

  .qty-btn:hover {
    background-color: #27272a;
  }

  .qty-input {
    width: 60px;
    height: 100%;
    background: transparent;
    border: none;
    color: var(--color-text);
    font-size: 1.1rem;
    font-weight: 600;
    text-align: center;
    font-family: var(--font-sans);
    -moz-appearance: textfield;
  }

  .qty-input::-webkit-outer-spin-button,
  .qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .add-to-cart-big {
    flex: 1;
    font-size: 1.1rem;
    letter-spacing: 0.05em;
    height: 52px;
  }

  .product-meta {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    background-color: var(--color-bg-secondary);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .meta-item svg {
    color: var(--color-primary);
  }
</style>
