---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
---

<Layout title="Registro | NeonClouds">
  <div class="auth-page animate-fade-in-up">
    <div class="container auth-container">
      <div class="auth-card glow-effect levitate" style="animation-duration: 9s;">
        <div class="auth-header">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="auth-icon"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
          <h1 class="auth-title">CREAR CUENTA</h1>
          <p class="auth-subtitle">Únete a la élite de NeonClouds hoy mismo.</p>
        </div>
        
        <form id="registerForm" class="auth-form">
          <div class="form-group">
            <label for="name">Nombre Completo</label>
            <input type="text" id="name" name="name" required placeholder="John Doe" class="auth-input" />
          </div>

          <div class="form-group">
            <label for="phone">Teléfono Móvil</label>
            <input type="tel" id="phone" name="phone" required placeholder="+34 600 000 000" class="auth-input" />
          </div>
          
          <div class="form-group">
            <label for="email">Correo Electrónico</label>
            <input type="email" id="email" name="email" required placeholder="tucorreo@ejemplo.com" class="auth-input" />
          </div>
          
          <div class="form-group">
            <label for="password">Contraseña</label>
            <input type="password" id="password" name="password" required placeholder="••••••••" class="auth-input" />
          </div>
          
          <Button type="submit" variant="primary" class="w-full auth-submit">REGISTRARME</Button>
        </form>
        
        <div class="auth-footer">
          <p>¿Ya tienes cuenta? <a href="/login" class="text-primary hover-underline">Inicia Sesión aquí</a></p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { loginUser } from '../store/auth';

  document.addEventListener('DOMContentLoaded', () => {
    const registerForm = document.getElementById('registerForm');
    
    registerForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const nameInput = document.getElementById('name') as HTMLInputElement;
      const emailInput = document.getElementById('email') as HTMLInputElement;
      const phoneInput = document.getElementById('phone') as HTMLInputElement;
      
      if (nameInput && emailInput && nameInput.value) {
        // Simulamos registro y autologin instantáneo
        loginUser({
          name: nameInput.value,
          email: emailInput.value,
          phone: phoneInput ? phoneInput.value : undefined
        });
        
        // Redirigir al inicio tras registrarse
        window.location.href = '/';
      }
    });
  });
</script>

<style>
  .auth-page {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 0;
    position: relative;
    overflow: hidden;
  }
  
  /* Radiación de fondo */
  .auth-page::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(0, 255, 102, 0.1) 0%, transparent 60%);
    z-index: -1;
  }

  .auth-container {
    max-width: 550px;
    width: 100%;
  }

  .auth-card {
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 3rem 2.5rem;
    box-shadow: var(--shadow-elevated);
    position: relative;
  }
  
  .auth-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  
  .auth-icon {
    margin-bottom: 1rem;
    filter: drop-shadow(0 0 10px var(--color-primary-glow));
  }

  .auth-title {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    letter-spacing: 0.05em;
  }

  .auth-subtitle {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .auth-input {
    background-color: var(--color-bg);
    border: 1px solid var(--border-color);
    color: var(--color-text);
    padding: 0.85rem 1rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    outline: none;
    transition: all var(--transition-fast);
  }

  .auth-input:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 1px var(--color-primary), inset 0 0 10px rgba(0, 255, 102, 0.1);
  }

  .auth-submit {
    margin-top: 0.5rem;
    padding: 1.2rem;
    font-size: 1.1rem;
    letter-spacing: 0.1em;
  }

  .w-full {
    width: 100%;
  }

  .auth-footer {
    margin-top: 1.5rem;
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .text-primary {
    color: var(--color-primary);
    font-weight: 600;
  }

  .hover-underline:hover {
    text-decoration: underline;
  }
</style>
