---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import ProductCard from '../components/ui/ProductCard.astro';

// Datos de ejemplo para la página principal
const featuredProducts = [
  {
    id: 'p1',
    name: 'Elf Bar 600 V2 - Watermelon Bubblegum',
    price: 7.50,
    category: 'Desechables',
    image: 'https://images.unsplash.com/photo-1579247289081-dc1a182b8e3c?q=80&w=1000&auto=format&fit=crop'
  },
  {
    id: 'p2',
    name: 'Vaporesso XROS 3 Pod Kit',
    price: 34.99,
    category: 'Kits & Pods',
    image: 'https://images.unsplash.com/photo-1546197116-bb984d4b1a53?q=80&w=1000&auto=format&fit=crop'
  },
  {
    id: 'p3',
    name: 'Riot Squad - Blue Burst 50ml',
    price: 14.50,
    category: 'Líquidos',
    image: 'https://images.unsplash.com/photo-1620606180536-f3b14d245dae?q=80&w=1000&auto=format&fit=crop'
  },
  {
    id: 'p4',
    name: 'Crystal Bar 600 - Cherry Ice',
    price: 6.99,
    category: 'Desechables',
    image: 'https://images.unsplash.com/photo-1618252273151-a0c3260840c5?q=80&w=1000&auto=format&fit=crop'
  }
];
---

<Layout title="NeonClouds | Vape Shop Premium">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container hero-container">
      <div class="hero-content">
        <div class="badge animate-fade-in-up">NUEVOS SABORES 2026</div>
        <h1 class="hero-title animate-fade-in-up delay-1">
          <span>NUBES </span>
          <span class="text-primary glow-text">ÉPICAS</span>
          <span>SIN LÍMITES.</span>
        </h1>
        <p class="hero-description animate-fade-in-up delay-2">
          Los mejores líquidos premium, pods desechables y kits de inicio. Diseños brutales y sabores intensos que rompen las reglas.
        </p>
        <div class="hero-actions animate-fade-in-up delay-3">
          <Button href="/products" variant="primary">Explorar Catálogo</Button>
          <Button href="#featured" variant="secondary">Ver Top Ventas</Button>
        </div>
      </div>
      <div class="hero-visual animate-fade-in-up delay-4">
        <!-- Elemento visual decorativo del hero -->
        <div class="abstract-shape levitate">
          <div class="shape-inner"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Marquee de Marcas (VapeoTotal style) -->
  <div class="marquee-wrapper">
    <div class="marquee-content">
      <span>VAPORESSO</span>
      <span class="dot">•</span>
      <span>ELF BAR</span>
      <span class="dot">•</span>
      <span>VOOPOO</span>
      <span class="dot">•</span>
      <span>RIOT SQUAD</span>
      <span class="dot">•</span>
      <span>LOST MARY</span>
      <span class="dot">•</span>
      <span>CRYSTAL BAR</span>
      <span class="dot">•</span>
      <span>JUST JUICE</span>
      <span class="dot">•</span>
      <!-- Duplicado para el efecto infinito -->
      <span>VAPORESSO</span>
      <span class="dot">•</span>
      <span>ELF BAR</span>
      <span class="dot">•</span>
      <span>VOOPOO</span>
      <span class="dot">•</span>
      <span>RIOT SQUAD</span>
      <span class="dot">•</span>
      <span>LOST MARY</span>
      <span class="dot">•</span>
      <span>CRYSTAL BAR</span>
      <span class="dot">•</span>
      <span>JUST JUICE</span>
      <span class="dot">•</span>
    </div>
  </div>

  <!-- Flash Sale Section -->
  <section class="flash-sale-section animate-fade-in-up">
    <div class="container hover-tilt">
      <div class="flash-sale-card glow-effect">
        <div class="flash-content">
          <div class="flash-badge">⚡ OFERTA RELÁMPAGO</div>
          <h2 class="flash-title" id="flashTitle">KITS DE INICIO AL <span class="text-primary">-40%</span></h2>
          <p class="flash-desc" id="flashDesc">El stock vuela. Consigue tu Vaporesso XROS 3 antes de que el contador llegue a cero.</p>
          <Button href="/products" variant="primary">Comprar Ahora</Button>
        </div>
        <div class="flash-timer">
          <div class="timer-box">
            <span id="hours" class="timer-value">00</span>
            <span class="timer-label">HORAS</span>
          </div>
          <div class="timer-separator">:</div>
          <div class="timer-box">
            <span id="minutes" class="timer-value">00</span>
            <span class="timer-label">MINS</span>
          </div>
          <div class="timer-separator">:</div>
          <div class="timer-box">
            <span id="seconds" class="timer-value">00</span>
            <span class="timer-label">SEGS</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Products Section -->
  <section id="featured" class="featured-section">
    <div class="container">
      <div class="section-header animate-fade-in-up">
        <h2 class="section-title">NUESTROS <span>TOP VENTAS</span></h2>
        <a href="/products" class="view-all">Ver todo el catálogo &rarr;</a>
      </div>
      
      <div class="products-grid">
        {featuredProducts.map((product, index) => (
          <div class={`animate-fade-in-up delay-${(index % 4) + 1}`}>
            <ProductCard 
              id={product.id}
              name={product.name}
              price={product.price}
              category={product.category}
              image={product.image}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Fake Reviews Section (Social Proof) -->
  <section class="reviews-section">
    <div class="container">
      <div class="section-header center-header animate-fade-in-up">
        <h2 class="section-title">LO QUE DICEN <span>NUESTROS CLIENTES</span></h2>
        <p class="section-subtitle">Más de 5,000 vapers confían en NeonClouds cada mes.</p>
      </div>

      <div class="reviews-grid">
        <!-- Review 1 -->
        <div class="review-card glow-effect animate-fade-in-up delay-1">
          <div class="review-header">
            <div class="review-avatar">M</div>
            <div class="review-meta">
              <h3 class="reviewer-name">Marcos T.</h3>
              <div class="review-stars">★★★★★</div>
            </div>
            <div class="verified-badge">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
              Comprador Verificado
            </div>
          </div>
          <p class="review-text">"El envío fue brutalmente rápido. Pedí unos desechables Elf Bar a las 16:00 y al día siguiente por la mañana ya los tenía en casa. Sabores increíbles."</p>
        </div>

        <!-- Review 2 -->
        <div class="review-card glow-effect animate-fade-in-up delay-2">
          <div class="review-header">
            <div class="review-avatar avatar-2">L</div>
            <div class="review-meta">
              <h3 class="reviewer-name">Laura G.</h3>
              <div class="review-stars">★★★★★</div>
            </div>
            <div class="verified-badge">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
              Comprador Verificado
            </div>
          </div>
          <p class="review-text">"La mejor tienda de vapeo de España sin duda. Los líquidos de Riot Squad siempre están en stock y el XROS 3 que compré va de lujo. 100% recomendados."</p>
        </div>

        <!-- Review 3 -->
        <div class="review-card glow-effect animate-fade-in-up delay-3">
          <div class="review-header">
            <div class="review-avatar avatar-3">D</div>
            <div class="review-meta">
              <h3 class="reviewer-name">David S.</h3>
              <div class="review-stars">★★★★☆</div>
            </div>
            <div class="verified-badge">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
              Comprador Verificado
            </div>
          </div>
          <p class="review-text">"Muy buenos precios en resistencias y sales de nicotina. La atención al cliente por WhatsApp me resolvió una duda al instante. Volveré a comprar seguro."</p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Banner Section -->
  <section class="banner-section animate-fade-in-up">
    <div class="container banner-container levitate" style="animation-duration: 10s;">
      <div class="banner-content">
        <h2>OFERTA BRUTAL</h2>
        <p>Suscríbete ahora y llévate un 15% de descuento en tu primer pedido de líquidos premium & desechables.</p>
        <div class="subscribe-form">
          <input type="email" placeholder="Tu correo electrónico" class="subscribe-input" />
          <Button variant="primary">¡Lo quiero!</Button>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Flash Sale Infinite Loop Logic
  document.addEventListener('DOMContentLoaded', () => {
    const hoursEl = document.getElementById('hours');
    const minutesEl = document.getElementById('minutes');
    const secondsEl = document.getElementById('seconds');
    const flashTitle = document.getElementById('flashTitle');
    const flashDesc = document.getElementById('flashDesc');

    if (!hoursEl || !minutesEl || !secondsEl || !flashTitle || !flashDesc) return;

    // Diferentes ofertas para rotar cuando el contador llegue a 0
    const offers = [
      {
        title: 'KITS DE INICIO AL <span class="text-primary">-40%</span>',
        desc: 'El stock vuela. Consigue tu Vaporesso XROS 3 antes de que el contador acabe.'
      },
      {
        title: 'LIQUIDOS PREMIUM <span class="text-primary">2x1</span>',
        desc: 'Añade 2 Riot Squad al carrito y paga solo 1. Oferta limitada por tiempo récord.'
      },
      {
        title: 'DESECHABLES DESDE <span class="text-primary">$4.99</span>',
        desc: 'Liquidación brutal en Elf Bar V2. Sabores seleccionados hasta fin de existencias.'
      }
    ];

    let currentOfferIndex = 0;
    // Empezamos con un tiempo bajo para probar/demo, o uno largo. Pongamos 1h 15m 10s inicial
    let timeInSeconds = 1 * 60 * 60 + 15 * 60 + 10; 

    function startFlashSale() {
      const timer = setInterval(() => {
        if (timeInSeconds <= 0) {
          clearInterval(timer);
          
          // Cambiar a la siguiente oferta
          currentOfferIndex = (currentOfferIndex + 1) % offers.length;
          flashTitle.innerHTML = offers[currentOfferIndex].title;
          flashDesc.textContent = offers[currentOfferIndex].desc;
          
          // Generar nuevo tiempo aleatorio entre 2 y 6 horas
          const randomHours = Math.floor(Math.random() * 5) + 2;
          const randomMinutes = Math.floor(Math.random() * 60);
          timeInSeconds = randomHours * 3600 + randomMinutes * 60;
          
          // Reiniciar el bucle visualmente
          const card = document.querySelector('.flash-sale-card') as HTMLElement;
          if (card) {
            card.style.animation = 'none';
            card.offsetHeight; /* trigger reflow */
            card.style.animation = 'pulse 0.5s ease-out';
          }
          
          startFlashSale(); // Empezar de nuevo
          return;
        }

        timeInSeconds--;

        const h = Math.floor(timeInSeconds / 3600);
        const m = Math.floor((timeInSeconds % 3600) / 60);
        const s = timeInSeconds % 60;

        hoursEl.textContent = h.toString().padStart(2, '0');
        minutesEl.textContent = m.toString().padStart(2, '0');
        secondsEl.textContent = s.toString().padStart(2, '0');
      }, 1000);
    }

    startFlashSale();

    // Hover tilt effect para la tarjeta flash
    const hoverTilt = document.querySelector('.hover-tilt') as HTMLElement;
    const flashCard = document.querySelector('.flash-sale-card') as HTMLElement;

    if (hoverTilt && flashCard) {
      hoverTilt.addEventListener('mousemove', (e) => {
        const rect = hoverTilt.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const rotateX = ((y - centerY) / centerY) * -5;
        const rotateY = ((x - centerX) / centerX) * 5;
        
        flashCard.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.01, 1.01, 1.01)`;
      });

      hoverTilt.addEventListener('mouseleave', () => {
        flashCard.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
      });
    }
  });
</script>

<style>
  /* Hero Section */
  .hero {
    position: relative;
    min-height: 90vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  
  .hero-bg {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(circle at 80% 20%, rgba(16, 185, 129, 0.15) 0%, transparent 40%),
      radial-gradient(circle at 20% 80%, rgba(16, 185, 129, 0.1) 0%, transparent 50%);
    z-index: -1;
  }
  
  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
    position: relative;
    z-index: 10;
  }
  
  @media (min-width: 1024px) {
    .hero-container {
      grid-template-columns: 1.2fr 1fr;
    }
  }
  
  .badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    background-color: rgba(16, 185, 129, 0.1);
    color: var(--color-primary);
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin-bottom: 2rem;
  }
  
  .hero-title {
    font-size: clamp(3rem, 8vw, 5.5rem);
    display: flex;
    flex-direction: column;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
  }
  
  .text-primary {
    color: var(--color-primary);
  }
  
  .glow-text {
    text-shadow: 0 0 40px rgba(16, 185, 129, 0.5);
  }
  
  .hero-description {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    max-width: 500px;
    margin-bottom: 3rem;
    line-height: 1.6;
  }
  
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  
  /* Abstract Shape for visual interest */
  .hero-visual {
    display: none;
    position: relative;
    height: 600px;
    justify-content: center;
    align-items: center;
  }
  
  @media (min-width: 1024px) {
    .hero-visual {
      display: flex;
    }
  }
  
  .abstract-shape {
    width: 400px;
    height: 500px;
    background: linear-gradient(135deg, var(--color-bg-secondary), #000);
    border: 1px solid var(--border-color);
    position: relative;
    transform: rotate(5deg);
    border-radius: 30px;
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(16, 185, 129, 0.1);
  }
  
  .abstract-shape::before {
    content: '';
    position: absolute;
    inset: -20px;
    background: radial-gradient(circle at top right, var(--color-primary), transparent 60%);
    opacity: 0.2;
    z-index: 1;
  }
  
  .shape-inner {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 250px;
    height: 250px;
    border-radius: 50%;
    background: 
      radial-gradient(circle at center, transparent 0%, transparent 60%, rgba(16, 185, 129, 0.2) 61%, transparent 70%),
      radial-gradient(circle at center, transparent 0%, transparent 40%, rgba(16, 185, 129, 0.3) 41%, transparent 50%),
      radial-gradient(circle at center, rgba(16, 185, 129, 0.1) 0%, transparent 30%);
    animation: pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  
  @keyframes pulse {
    0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
    50% { transform: translate(-50%, -50%) scale(1.05); opacity: 0.8; }
  }

  /* Marquee de Marcas */
  .marquee-wrapper {
    width: 100%;
    overflow: hidden;
    background-color: var(--color-primary);
    color: var(--color-bg);
    padding: 1rem 0;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    display: flex;
    white-space: nowrap;
    position: relative;
    box-shadow: 0 0 20px rgba(0, 255, 102, 0.2);
  }

  .marquee-content {
    display: flex;
    align-items: center;
    gap: 3rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    text-transform: uppercase;
    animation: marqueeScroll 20s linear infinite;
  }

  .dot {
    font-size: 1rem;
    opacity: 0.5;
  }

  @keyframes marqueeScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); } /* Se mueve la mitad exacto (debido a la duplicación manual de items) */
  }

  /* Flash Sale Section */
  .flash-sale-section {
    padding: 4rem 0 2rem 0;
  }

  .hover-tilt {
    perspective: 1000px;
    transform-style: preserve-3d;
  }

  .flash-sale-card {
    display: flex;
    flex-direction: column;
    background: linear-gradient(135deg, var(--color-bg-secondary) 0%, #0a0a0c 100%);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 3rem;
    overflow: hidden;
    position: relative;
    transition: transform 0.2s ease-out;
    box-shadow: var(--shadow-elevated);
  }

  @media (min-width: 768px) {
    .flash-sale-card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 3rem;
    }
  }

  .flash-sale-card::after {
    content: '';
    position: absolute;
    right: -20%;
    top: -50%;
    width: 50%;
    height: 200%;
    background: radial-gradient(circle, rgba(0, 255, 102, 0.1) 0%, transparent 70%);
    pointer-events: none;
  }

  .flash-content {
    flex: 1;
    z-index: 10;
  }

  .flash-badge {
    display: inline-block;
    color: #000;
    background-color: var(--color-primary);
    padding: 0.3rem 0.8rem;
    font-weight: 800;
    font-size: 0.8rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1rem;
    letter-spacing: 0.1em;
    box-shadow: 0 0 15px var(--color-primary-glow);
  }

  .flash-title {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 1rem;
    line-height: 1.1;
  }

  .flash-desc {
    color: var(--color-text-muted);
    margin-bottom: 2rem;
    font-size: 1.1rem;
    max-width: 450px;
  }

  .flash-timer {
    display: flex;
    align-items: center;
    gap: 1rem;
    z-index: 10;
    margin-top: 2rem;
  }

  @media (min-width: 768px) {
    .flash-timer {
      margin-top: 0;
    }
  }

  .timer-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(0, 255, 102, 0.3);
    padding: 1rem 1.5rem;
    border-radius: var(--radius-md);
    min-width: 90px;
  }

  .timer-value {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--color-primary);
    text-shadow: 0 0 10px rgba(0, 255, 102, 0.5);
    line-height: 1;
  }

  .timer-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-top: 0.5rem;
    letter-spacing: 0.05em;
  }

  .timer-separator {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--color-text-muted);
  }

  /* Featured Section */
  .featured-section {
    padding: 6rem 0;
    position: relative;
  }
  
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1rem;
  }
  
  .section-title {
    font-size: 2.5rem;
    text-transform: uppercase;
    margin-bottom: 0;
  }
  
  .section-title span {
    color: var(--color-primary);
  }
  
  .view-all {
    color: var(--color-text-muted);
    font-weight: 500;
    transition: color var(--transition-fast);
  }
  
  .view-all:hover {
    color: var(--color-primary);
  }
  
  .products-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 2rem;
  }
  
  @media (min-width: 640px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (min-width: 1024px) {
    .products-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  
  /* Banner Section */
  .banner-section {
    padding: 4rem 0 8rem 0;
  }
  
  .banner-container {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(9, 9, 11, 0.8));
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: var(--radius-lg);
    padding: 4rem 2rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  
  .banner-container::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at center, rgba(16, 185, 129, 0.1) 0%, transparent 60%);
    pointer-events: none;
  }
  
  .banner-content {
    position: relative;
    z-index: 10;
    max-width: 600px;
    margin: 0 auto;
  }
  
  .banner-content h2 {
    font-size: 2.5rem;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  
  .banner-content p {
    color: var(--color-text-muted);
    margin-bottom: 2rem;
    font-size: 1.1rem;
  }
  
  .subscribe-form {
    display: flex;
    gap: 1rem;
    max-width: 450px;
    margin: 0 auto;
  }
  
  .subscribe-input {
    flex: 1;
    background-color: var(--color-bg);
