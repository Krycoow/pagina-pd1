---
import Button from './ui/Button.astro';
---

<div id="ageGateModal" class="age-modal-overlay" aria-hidden="false">
  <div class="age-modal-content glow-effect">
    <div class="age-modal-header">
      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="warning-icon">
        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
        <line x1="12" y1="9" x2="12" y2="13"></line>
        <line x1="12" y1="17" x2="12.01" y2="17"></line>
      </svg>
      <h2 class="age-title">VERIFICACIÓN DE EDAD</h2>
    </div>
    
    <div class="age-modal-body">
      <p>Los productos de vapeo mostrados en <strong>NeonClouds</strong> contienen nicotina y son exclusivamente para adultos.</p>
      <p class="age-question">¿TIENES MÁS DE 18 AÑOS?</p>
    </div>
    
    <div class="age-modal-actions">
      <Button variant="primary" id="btnYes18" class="age-btn w-full">SÍ, TENGO +18 AÑOS</Button>
      <Button variant="outline" id="btnNo18" class="age-btn w-full">NO, SOY MENOR</Button>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('ageGateModal');
    const btnYes = document.getElementById('btnYes18');
    const btnNo = document.getElementById('btnNo18');
    
    // Mostramos siempre la ventana por petición de demo (sin bypass de localStorage)
    if (modal) {
      // Bloquear scroll mientras el modal esté abierto
      document.body.style.overflow = 'hidden';
      
      btnYes?.addEventListener('click', () => {
        modal.style.opacity = '0';
        setTimeout(() => {
          modal.style.display = 'none';
          modal.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }, 400); // Coincide con la transición CSS
      });

      btnNo?.addEventListener('click', () => {
        // Redirigir a Google o mostrar un mensaje restrictivo severo
        alert('Lo sentimos. El acceso a esta web está restringido a mayores de edad.');
        window.location.href = 'https://www.google.com';
      });
    }
  });
</script>

<style>
  .age-modal-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(10px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    transition: opacity 400ms ease;
  }

  .age-modal-content {
    background-color: var(--color-bg-secondary);
    border: 2px solid var(--border-color);
    border-radius: var(--radius-lg);
    max-width: 500px;
    width: 100%;
    padding: 3rem 2rem;
    text-align: center;
    position: relative;
    box-shadow: 0 0 50px rgba(0, 255, 102, 0.1);
    transform: translateY(0);
    animation: modalPopIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  /* Glow effect especial para el modal */
  .age-modal-content::after {
    content: '';
    position: absolute;
    inset: -2px;
    background: linear-gradient(45deg, var(--color-primary), #000, var(--color-primary));
    z-index: -1;
    filter: blur(8px);
    opacity: 0.5;
    border-radius: calc(var(--radius-lg) + 2px);
    animation: flowBorders 4s linear infinite;
  }

  .age-modal-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .warning-icon {
    color: var(--color-primary);
    filter: drop-shadow(0 0 10px var(--color-primary-glow));
  }

  .age-title {
    font-size: 2rem;
    color: var(--color-text);
    margin: 0;
    letter-spacing: 0.05em;
  }

  .age-modal-body {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  .age-question {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    margin-top: 1.5rem;
    text-transform: uppercase;
  }

  .age-modal-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .w-full {
    width: 100%;
  }

  .age-btn {
    padding: 1.2rem;
    font-size: 1.1rem;
    letter-spacing: 0.05em;
  }

  @keyframes modalPopIn {
    0% { opacity: 0; transform: scale(0.9) translateY(20px); }
    100% { opacity: 1; transform: scale(1) translateY(0); }
  }

  @keyframes flowBorders {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
</style>
