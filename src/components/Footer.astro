---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-container">
    <div class="footer-brand">
      <h2 class="logo">NeonClouds</h2>
      <p class="description">Nubes épicas. Sabores brutales. Tu vape shop de confianza.</p>
    </div>
    
    <div class="footer-links">
      <div class="link-column">
        <h3>Tienda</h3>
        <ul>
          <li><a href="/products">Desechables</a></li>
          <li><a href="/products">Líquidos</a></li>
          <li><a href="/products">Kits & Pods</a></li>
        </ul>
      </div>
      <div class="link-column">
        <h3>Soporte</h3>
        <ul>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/envios">Envíos</a></li>
          <li><a href="/contacto">Contacto</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="container">
      <p>&copy; {currentYear} NeonClouds. Todos los derechos reservados. Productos exclusivos para mayores de 18 años.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-bg-secondary);
    border-top: 1px solid var(--border-color);
    margin-top: 4rem;
    padding-top: 4rem;
  }

  .footer-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 768px) {
    .footer-container {
      grid-template-columns: 1fr 2fr;
    }
  }

  .logo {
    font-family: var(--font-display);
    font-size: 2rem;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .description {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    max-width: 300px;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .link-column h3 {
    font-size: 1rem;
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  .link-column ul {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .link-column a {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    transition: color var(--transition-fast);
  }

  .link-column a:hover {
    color: var(--color-primary);
  }

  .footer-bottom {
    background-color: var(--color-bg);
    border-top: 1px solid var(--border-color);
    padding: 1.5rem 0;
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }
</style>
