---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  class?: string;
  id?: string;
  type?: 'button' | 'submit' | 'reset';
  [key: string]: any; // Permite pasar atributos data-* libremente
}

const { 
  href, 
  variant = 'primary', 
  class: className = '',
  id,
  type = 'button',
  ...rest
} = Astro.props;

const baseClass = 'btn';
const variantClass = `btn-${variant}`;
const combinedClass = `${baseClass} ${variantClass} ${className}`;
---

{href ? (
  <a href={href} class={combinedClass} id={id} {...rest}>
    <span class="btn-content"><slot /></span>
  </a>
) : (
  <button type={type} class={combinedClass} id={id} {...rest}>
    <span class="btn-content"><slot /></span>
  </button>
)}

<style>
  .btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    position: relative;
    padding: 0.75rem 1.5rem;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
    overflow: hidden;
    user-select: none;
    z-index: 1;
  }

  .btn-content {
    position: relative;
    z-index: 2;
  }

  /* Primary Button - Brutalist Emerald */
  .btn-primary {
    background-color: var(--color-primary);
    color: #000; /* Alto contraste */
    border: none;
  }

  .btn-primary:hover {
    background-color: var(--color-primary-hover);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px var(--color-primary-glow);
  }

  .btn-primary:active {
    transform: translateY(0);
  }

  /* Secondary Button - Dark Muted */
  .btn-secondary {
    background-color: var(--color-bg-secondary);
    color: var(--color-text);
    border: 1px solid var(--border-color);
  }

  .btn-secondary:hover {
    background-color: #27272a; /* zinc-800 */
    border-color: #3f3f46; /* zinc-700 */
  }

  /* Outline Button -> Ghost */
  .btn-outline {
    background-color: transparent;
    color: var(--color-primary);
    border: 2px solid var(--color-primary);
  }

  .btn-outline:hover {
    background-color: rgba(16, 185, 129, 0.1); /* Primary con opacidad */
    box-shadow: 0 0 15px var(--color-primary-glow);
  }
</style>
