---
import Button from './Button.astro';

interface Props {
  id: string;
  name: string;
  price: number;
  image: string;
  category: string;
}

const { id, name, price, image, category } = Astro.props;
---

<article class="product-card glow-effect group" data-product-id={id}>
  <a href={`/product/${id}`} class="product-link">
    <div class="image-wrapper">
      <img src={image} alt={name} loading="lazy" class="product-image" />
      <div class="category-badge">{category}</div>
      <div class="fomo-badge-container" data-fomo-id={id} style="display: none;">
        <div class="fomo-badge pulse-fomo">
          🔥 Quedan <span class="fomo-count"></span>
        </div>
      </div>
    </div>
    
    <div class="product-info">
      <h3 class="product-name">{name}</h3>
      <div class="product-rating">
        <span class="stars-icon">★★★★★</span>
        <span class="rating-number">4.8</span>
      </div>
      <div class="price-action">
        <span class="product-price">${price.toFixed(2)}</span>
      </div>
    </div>
  </a>
  
  <div class="action-footer">
    <Button 
      variant="outline" 
      class="add-to-cart-btn" 
      data-action="add"
      data-id={id}
      data-name={name}
      data-price={price}
      data-image={image}
    >
      Añadir al carrito
    </Button>
  </div>
</article>

<script>
  // 3D Tilt Effect for Product Cards
  document.addEventListener('DOMContentLoaded', () => {
    // 1) Lógica 3D
    const cards = document.querySelectorAll('.product-card');
    
    cards.forEach(card => {
      // @ts-ignore
      card.addEventListener('mousemove', (e) => {
        // @ts-ignore
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left; // x position within the element.
        const y = e.clientY - rect.top;  // y position within the element.
        
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        
        const rotateX = ((y - centerY) / centerY) * -10; // Max 10 deg rotation
        const rotateY = ((x - centerX) / centerX) * 10;
        
        // @ts-ignore
        card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
        // @ts-ignore
        card.style.boxShadow = 'var(--shadow-neon-intense)';
      });
      
      card.addEventListener('mouseleave', () => {
        // @ts-ignore
        card.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
        // @ts-ignore
        card.style.boxShadow = 'none';
      });
    });

    // 2) Lógica FOMO Dinámica (cambia cada 2 horas basado en el timestamp)
    const updateFomoBadges = () => {
      const containers = document.querySelectorAll('.fomo-badge-container');
      if (!containers.length) return;
      
      const now = new Date();
      // Ciclo de rotación: Aproximadamente 2 horas (en milisegundos)
      const cycleTime = 2 * 60 * 60 * 1000;
      const seed = Math.floor(now.getTime() / cycleTime);
      
      containers.forEach(container => {
        const id = container.getAttribute('data-fomo-id') || '';
        let idNum = 0;
        for(let i=0; i<id.length; i++) idNum += id.charCodeAt(i);
        
        // Sumamos el ID único del producto + la semilla de tiempo
        const combinedSeed = idNum + seed;
        
        // Probabilidad de ~33% de tener "Bajo Stock"
        const isLowStock = (combinedSeed % 3) === 0;
        
        if (isLowStock) {
          (container as HTMLElement).style.display = 'block';
          const countSpan = container.querySelector('.fomo-count');
          if (countSpan) {
            // El número de stock restante será de 2 a 5
            countSpan.textContent = ((combinedSeed % 4) + 2).toString();
          }
        } else {
          (container as HTMLElement).style.display = 'none';
        }
      });
    };

    updateFomoBadges();
    // Actualiza en tiempo real por si el usuario deja la pestaña abierta al cruzar el ciclo horario
    setInterval(updateFomoBadges, 60000);
  });
</script>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform 0.1s ease, box-shadow var(--transition-normal), border-color var(--transition-normal);
    height: 100%;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .product-card:hover {
    border-color: var(--color-primary);
  }

  .product-link {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .image-wrapper {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: #27272a; /* Standby bg for images */
  }

  .product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms cubic-bezier(0.4, 0, 0.2, 1);
    transform: translateZ(20px); /* 3D pop effect */
  }

  .product-card:hover .product-image {
    transform: scale(1.1) translateZ(30px);
  }

  .category-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background-color: rgba(9, 9, 11, 0.8);
    backdrop-filter: blur(4px);
    color: var(--color-text);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 1px solid var(--border-color);
    z-index: 10;
  }

  .fomo-badge {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    background-color: #ef4444; /* Rojo urgencia */
    color: #fff;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    box-shadow: 0 0 10px rgba(239, 68, 68, 0.5);
    z-index: 10;
  }

  .pulse-fomo {
    animation: fomoPulse 2s infinite;
  }

  @keyframes fomoPulse {
    0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
    70% { box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); }
    100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
  }

  .product-info {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-name {
    font-size: 1.1rem;
    color: var(--color-text);
    margin-bottom: 0.25rem;
    font-family: var(--font-sans);
    font-weight: 600;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-rating {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    font-size: 0.85rem;
  }

  .stars-icon {
    color: var(--color-primary);
    letter-spacing: 0.1em;
  }

  .rating-number {
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .price-action {
    margin-top: auto;
  }

  .product-price {
    font-size: 1.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-primary);
  }

  .action-footer {
    padding: 0 1.5rem 1.5rem 1.5rem;
  }

  .add-to-cart-btn {
    width: 100%;
  }

  /* Brutal effect only for the button when parent is hovered */
  .product-card:hover .add-to-cart-btn {
    background-color: var(--color-primary);
    color: #000;
    box-shadow: 0 4px 20px var(--color-primary-glow);
  }
</style>
