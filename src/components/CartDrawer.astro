---
---
<div id="cartDrawer" class="cart-drawer" aria-hidden="true">
  <div class="cart-backdrop" id="cartBackdrop"></div>
  
  <aside class="cart-panel">
    <header class="cart-header">
      <h2 class="cart-title">TU ARSENAL <span class="cart-count badge-count">0</span></h2>
      <button class="cart-close-btn" id="cartCloseBtn" aria-label="Cerrar carrito">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </header>

    <div class="cart-body">
      <!-- Los items se renderizan dinámicamente aquí vía JS -->
      <ul id="cartItemsList" class="cart-items-list">
        <!-- Template vacío inicial hiper-visual -->
        <li class="empty-cart-message" id="emptyCartMsg">
          <div class="empty-icon-wrapper glow-effect">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="empty-icon-svg">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
              <line x1="15" y1="9" x2="9" y2="15"></line>
              <line x1="9" y1="9" x2="15" y2="15"></line>
            </svg>
          </div>
          <h3 class="empty-title">TUS NUBES ESTÁN VACÍAS</h3>
          <p class="empty-desc">Añade los mejores líquidos y desechables a tu arsenal para continuar.</p>
          <a href="/products" class="btn btn-primary btn-giant" id="continueShoppingBtn">
            <span class="btn-content">¡LLENAR EL CARRITO!</span>
          </a>
        </li>
      </ul>
    </div>

    <footer class="cart-footer">
      <div class="cart-totals">
        <div class="total-row">
          <span>Subtotal</span>
          <span id="cartSubtotal">$0.00</span>
        </div>
        <div class="total-row total-final">
          <span>Total</span>
          <span id="cartTotal" class="total-price">$0.00</span>
        </div>
      </div>
      <button class="btn btn-primary checkout-btn" id="checkoutBtn" disabled>
        DEMO DE PAGO
      </button>
    </footer>
  </aside>
</div>

<!-- Template para un item del carrito (usado por JS) -->
<template id="cartItemTemplate">
  <li class="cart-item">
    <div class="item-image-wrapper">
      <img src="" alt="" class="item-image" />
    </div>
    <div class="item-info">
      <h3 class="item-name"></h3>
      <p class="item-price"></p>
      <div class="item-controls">
        <div class="quantity-control">
          <button class="qty-btn decrement" aria-label="Reducir cantidad">-</button>
          <span class="qty-value">1</span>
          <button class="qty-btn increment" aria-label="Aumentar cantidad">+</button>
        </div>
        <button class="remove-btn" aria-label="Eliminar del carrito">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="3 6 5 6 21 6"></polyline>
            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          </svg>
        </button>
      </div>
    </div>
  </li>
</template>

<script>
  import { cartItems, removeCartItem, updateCartQuantity } from '../store/cart';

  // Lógica del UI del Drawer
  const cartDrawer = document.getElementById('cartDrawer');
  const cartBackdrop = document.getElementById('cartBackdrop');
  const cartCloseBtn = document.getElementById('cartCloseBtn');
  const continueShoppingBtn = document.getElementById('continueShoppingBtn');
  
  // Función para abrir el carrito (se expone globalmente para que el Header la use)
  window.openCart = () => {
    cartDrawer?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden'; // Prevenir scroll de la página
  };

  // Funciones para cerrar
  const closeCart = () => {
    cartDrawer?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  };

  cartBackdrop?.addEventListener('click', closeCart);
  cartCloseBtn?.addEventListener('click', closeCart);
  if(continueShoppingBtn) {
     continueShoppingBtn.addEventListener('click', () => {
       closeCart();
     });
  }

  // Interceptar clicks en los botones de "Abrir carrito" del header (setup en Layout si es necesario o manejado por ID)
  document.addEventListener('DOMContentLoaded', () => {
    const headerCartBtn = document.getElementById('cartToggleBtn');
    headerCartBtn?.addEventListener('click', window.openCart);

    // Lógica del botón de Checkout
    const checkoutBtnEl = document.getElementById('checkoutBtn');
    checkoutBtnEl?.addEventListener('click', () => {
      window.location.href = '/checkout-success';
    });
  });

  // Lógica de Renderizado Reactiva conectada a Nano Stores
  const cartItemsList = document.getElementById('cartItemsList');
  const emptyCartMsg = document.getElementById('emptyCartMsg');
  const cartSubtotal = document.getElementById('cartSubtotal');
  const cartTotal = document.getElementById('cartTotal');
  const checkoutBtn = document.getElementById('checkoutBtn');
  const itemTemplate = document.getElementById('cartItemTemplate') as HTMLTemplateElement;

  function renderCart(itemsRecord) {
    if (!cartItemsList || !itemTemplate || !emptyCartMsg) return;

    const items = Object.values(itemsRecord);
    
    // Limpiar lista preservando el mensaje vacío
    Array.from(cartItemsList.children).forEach(child => {
      if (child.id !== 'emptyCartMsg') {
        cartItemsList.removeChild(child);
      }
    });

    if (items.length === 0) {
      emptyCartMsg.style.display = 'flex';
      if (checkoutBtn) {
         checkoutBtn.setAttribute('disabled', 'true');
         checkoutBtn.classList.add('disabled');
      }
      if (cartSubtotal) cartSubtotal.textContent = '$0.00';
      if (cartTotal) cartTotal.textContent = '$0.00';
      return;
    }

    emptyCartMsg.style.display = 'none';
    if (checkoutBtn) {
       checkoutBtn.removeAttribute('disabled');
       checkoutBtn.classList.remove('disabled');
    }

    let total = 0;

    items.forEach(item => {
      total += item.price * item.quantity;
      
      const clone = itemTemplate.content.cloneNode(true) as DocumentFragment;
      const li = clone.querySelector('li')!;
      
      // Llenar datos
      const img = clone.querySelector('.item-image') as HTMLImageElement;
      img.src = item.image;
      img.alt = item.name;
      
      clone.querySelector('.item-name')!.textContent = item.name;
      clone.querySelector('.item-price')!.textContent = `$${(item.price * item.quantity).toFixed(2)}`;
      clone.querySelector('.qty-value')!.textContent = item.quantity.toString();

      // Event Listeners para cada item
      const removeBtn = clone.querySelector('.remove-btn');
      removeBtn?.addEventListener('click', () => removeCartItem(item.id));

      const decBtn = clone.querySelector('.decrement');
      decBtn?.addEventListener('click', () => updateCartQuantity(item.id, item.quantity - 1));

      const incBtn = clone.querySelector('.increment');
      incBtn?.addEventListener('click', () => updateCartQuantity(item.id, item.quantity + 1));

      // Animación de entrada
      li.style.animation = 'slideInRight 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards';
      
      cartItemsList.appendChild(li);
    });

    // Actualizar totales
    const formattedTotal = `$${total.toFixed(2)}`;
    if (cartSubtotal) cartSubtotal.textContent = formattedTotal;
    if (cartTotal) cartTotal.textContent = formattedTotal;
  }

  // Suscribirse a los cambios de la tienda
  cartItems.subscribe(renderCart);
</script>

<style>
  /* Base del Drawer */
  .cart-drawer[aria-hidden="true"] {
    visibility: hidden;
  }

  .cart-drawer[aria-hidden="true"] .cart-backdrop {
    opacity: 0;
  }

  .cart-drawer[aria-hidden="true"] .cart-panel {
    transform: translateX(100%);
  }

  .cart-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
    z-index: 100;
    opacity: 1;
    transition: opacity var(--transition-normal);
  }

  .cart-panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 450px;
    background-color: var(--color-bg);
    border-left: 1px solid var(--border-color);
    z-index: 101;
    display: flex;
    flex-direction: column;
    transform: translateX(0);
    transition: transform 400ms cubic-bezier(0.2, 0.8, 0.2, 1);
    box-shadow: -10px 0 30px rgba(0, 0, 0, 0.5);
  }

  /* Header del Drawer */
  .cart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem;
    border-bottom: 1px solid var(--border-color);
    background-color: var(--color-bg-secondary);
  }

  .cart-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .badge-count {
    background-color: var(--color-primary);
    color: var(--color-bg);
    font-size: 0.8rem;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
  }

  .cart-close-btn {
    color: var(--color-text-muted);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .cart-close-btn:hover {
    color: var(--color-primary);
    transform: scale(1.1);
  }

  /* Body y Lista de Items */
  .cart-body {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
  }

  .cart-body::-webkit-scrollbar {
    width: 6px;
  }

  .cart-body::-webkit-scrollbar-track {
    background: var(--color-bg);
  }

  .cart-body::-webkit-scrollbar-thumb {
    background: var(--border-color);
    border-radius: 3px;
  }

  .cart-items-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .empty-cart-message {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem 1rem;
    color: var(--color-text-muted);
    height: 100%;
    gap: 1.5rem;
  }

  .empty-icon-wrapper {
    background-color: var(--color-bg);
    border: 1px dashed var(--border-color);
    width: 120px;
    height: 120px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .empty-icon-svg {
    color: var(--border-color);
    transition: color var(--transition-normal);
  }

  .empty-icon-wrapper:hover .empty-icon-svg {
    color: var(--color-text-muted);
  }

  .empty-title {
    color: var(--color-text);
    font-size: 1.5rem;
    margin: 0;
    line-height: 1.2;
  }

  .empty-desc {
    font-size: 1rem;
    line-height: 1.5;
    margin-bottom: 0.5rem;
  }

  .btn-giant {
    width: 100%;
    padding: 1.25rem;
    font-size: 1.1rem;
    letter-spacing: 0.05em;
    margin-top: 0.5rem;
  }

  /* Cart Item Individual */
  .cart-item {
    display: flex;
    gap: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px dashed var(--border-color);
  }

  .item-image-wrapper {
    width: 80px;
    height: 80px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background-color: var(--color-bg-secondary);
    flex-shrink: 0;
    border: 1px solid var(--border-color);
  }

  .item-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .item-info {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .item-name {
    font-size: 0.95rem;
    font-weight: 500;
    margin-bottom: 0.25rem;
    line-height: 1.3;
  }

  .item-price {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-primary);
    font-family: var(--font-display);
    margin-bottom: auto;
  }

  .item-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.75rem;
  }

  .quantity-control {
    display: flex;
    align-items: center;
    background-color: var(--color-bg-secondary);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    overflow: hidden;
  }

  .qty-btn {
    width: 28px;
    height: 28px;
    color: var(--color-text);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color var(--transition-fast);
  }

  .qty-btn:hover {
    background-color: #3f3f46;
  }

  .qty-value {
    width: 30px;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .remove-btn {
    color: var(--color-text-muted);
    padding: 0.25rem;
    transition: color var(--transition-fast);
  }

  .remove-btn:hover {
    color: #ef4444; /* red-500 */
  }

  /* Footer y Checkout */
  .cart-footer {
    padding: 1.5rem;
    background-color: var(--color-bg-secondary);
    border-top: 1px solid var(--border-color);
  }

  .cart-totals {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .total-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .total-final {
    color: var(--color-text);
    font-size: 1.1rem;
    font-weight: 600;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-color);
  }

  .total-price {
    color: var(--color-primary);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .checkout-btn {
    width: 100%;
    padding: 1rem;
    font-size: 1.1rem;
    letter-spacing: 0.05em;
  }

  .checkout-btn.disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @keyframes slideInRight {
    from {
      opacity: 0;
      transform: translateX(20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>
